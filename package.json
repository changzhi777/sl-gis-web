{
  "name": "sl-gis-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:update": "playwright test --update-snapshots",
    "health": "pnpm typecheck && pnpm build",
    "typecheck:build": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "gis",
    "water-supply",
    "data-viz",
    "echarts"
  ],
  "author": "常智",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "echarts": "^5.6.0",
    "mockjs": "1.1.0",
    "pinia": "^2.3.1",
    "v-scale-screen": "^2.3.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/countup.js": "^2.0.7",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.104.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  }
}